<Window x:Class="ZwiftAccountSwitcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Zwift Account Switcher" Icon="Assets/AppIcon.ico" Height="650" Width="840"
        MinHeight="540" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Background="#F4F5F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#22252A" Padding="24,18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Zwift Account Switcher" Foreground="White" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="Choose an account, then start Zwift safely." Foreground="#D6D8DC" Margin="0,4,0,0" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="Add account" Command="{Binding AddCommand}"
                        AutomationProperties.Name="Add a Zwift account" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Margin="20,16,20,4" Padding="14" Background="White" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Launcher:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding LauncherPathDisplay}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" AutomationProperties.Name="Selected Zwift Launcher path" />
                <Button Grid.Column="2" Content="Browse…" Click="Browse_Click" IsEnabled="{Binding CanEditAccounts}"
                        AutomationProperties.Name="Browse for Zwift Launcher" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="20,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Accounts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="370" MinHeight="150" Margin="6" Padding="18" Background="White" CornerRadius="7"
                                    BorderBrush="#D8DADD" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="21" FontWeight="SemiBold"
                                               TextWrapping="Wrap" AutomationProperties.Name="{Binding DisplayName}" />
                                    <WrapPanel Grid.Row="1" Margin="-4,12,-4,-4">
                                        <Button Content="Ride as…"
                                                Command="{Binding DataContext.RideCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                CommandParameter="{Binding}"
                                                Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold"
                                                AutomationProperties.Name="{Binding DisplayName, StringFormat=Ride as {0}}" />
                                        <Button Content="Edit"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding DisplayName, StringFormat=Edit {0}}" />
                                        <Button Content="Delete"
                                                Command="{Binding DataContext.RequestDeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding DisplayName, StringFormat=Delete {0}}" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Background="#F4F5F7" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Accounts.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="No accounts saved. Choose Add account to begin." FontSize="17" Foreground="#555" />
            </Border>

            <Border Background="#EEFFFFFF" BorderBrush="#AEB2B8" BorderThickness="1" CornerRadius="8"
                    Padding="24" Width="430" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel DataContext="{Binding Editor}">
                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <Label Content="Display name" Target="{Binding ElementName=DisplayNameBox}" />
                    <TextBox x:Name="DisplayNameBox" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" />
                    <Label Content="Zwift username or email" Target="{Binding ElementName=UsernameBox}" />
                    <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" MaxLength="320" />
                    <Label Content="Password" Target="{Binding ElementName=EditorPasswordBox}" />
                    <PasswordBox x:Name="EditorPasswordBox" MaxLength="512" AutomationProperties.Name="Zwift password" />
                    <TextBlock Text="{Binding PasswordHint}" Foreground="#666" Margin="0,-6,0,10" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Click="CancelEditor_Click" />
                        <Button Content="Save" Click="SaveEditor_Click" IsDefault="True"
                                Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="White" BorderBrush="#D8DADD" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar Height="4" Margin="0,8,16,0" IsIndeterminate="True">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
                <Button Grid.Column="1" Content="Cancel login" Command="{Binding CancelLoginCommand}"
                        AutomationProperties.Name="Cancel login before game launch" />
            </Grid>
        </Border>
    </Grid>
</Window>
